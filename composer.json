{
  "name": "coreshop/test-setup",
  "type": "library",
  "description": "CoreShop Shared Test Setup",
  "keywords": [
    "coreshop", "dev"
  ],
  "homepage": "https://www.coreshop.com",
  "license": "MIT",
  "authors": [
    {
      "name": "CoreShop GmbH",
      "email": "info@coreshop.com",
      "homepage": "https://www.coreshop.com/",
      "role": "TEAM"
    }
  ],
  "require": {
    "behat/behat": "^3.21",
    "behat/mink": "^1.11",
    "dbrekelmans/bdi": "^1.3",
    "friends-of-behat/mink-debug-extension": "^2.1",
    "friends-of-behat/mink-extension": "^2.7",
    "friends-of-behat/page-object-extension": "^0.3.2",
    "friends-of-behat/symfony-extension": "^2.1",
    "gotenberg/gotenberg-php": "^2.8",
    "phpstan/phpstan": "^2.0",
    "phpstan/phpstan-symfony": "^2.0",
    "phpunit/phpunit": "^10",
    "robertfausk/behat-panther-extension": "^1.1",
    "symfony/dotenv": "^6.4",
    "symfony/panther": "^2.1",
    "symplify/easy-coding-standard": "^11.1",
    "vimeo/psalm": "^6.10"
  },
  "require-dev": {
    "coreshop/core-shop": "4.1.x-dev"
  },
  "extra": {
    "branch-alias": {
      "dev-main": "1.0-dev"
    }
  },
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "php-http/discovery": true
    },
    "sort-packages": true
  }
}
